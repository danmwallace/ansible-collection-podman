# Managed by Ansible - danmwallace.podman.arcane
[Unit]
Description=Arcane container management UI
Requires=arcane-socket-proxy.service
After=network-online.target arcane-postgres.service arcane-socket-proxy.service

[Container]
# Arcane 3.x dropped the GHCR-only `arcane` alias; the image is `manager`.
Image=ghcr.io/getarcaneapp/manager:{{ arcane_version }}
ContainerName=arcane
Network=arcane.network
Network=arcane-socket.network
Network=proxy_network.network
# Arcane 3.x reads only ARCANE_-prefixed names and refuses to start if an
# unprefixed 2.x name is set. PUID, PGID and DOCKER_HOST are standard names and
# keep theirs. Arcane reads its DB credentials from ARCANE_DATABASE_URL; the
# POSTGRES_* names belong to arcane-postgres only.
Environment=ARCANE_APP_URL=https://{{ arcane_hostname }}
Environment=PUID=1000
Environment=PGID=1000
Environment=ARCANE_ENCRYPTION_KEY={{ arcane_encryption_key }}
Environment=ARCANE_LOG_LEVEL=info
Environment=ARCANE_LOG_JSON=false
Environment=ARCANE_DATABASE_URL=postgresql://{{ arcane_postgres_user }}:{{ arcane_postgres_password }}@arcane-postgres:5432/{{ arcane_postgres_db }}
Environment=DOCKER_HOST=tcp://arcane-socket-proxy:2375
Label=traefik.enable=true
Label=traefik.docker.network=systemd-proxy_network
Label=traefik.http.routers.arcane.rule=Host(`{{ arcane_hostname }}`)
Label=traefik.http.routers.arcane.entrypoints=websecure
Label=traefik.http.routers.arcane.tls.certresolver=cloudflare
Label=traefik.http.services.arcane.loadbalancer.server.port=3552

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
