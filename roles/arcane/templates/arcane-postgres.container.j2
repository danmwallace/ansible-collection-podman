# Managed by Ansible - danmwallace.podman.arcane
[Unit]
Description=Arcane Postgres database
After=network-online.target

[Container]
Image=docker.io/library/postgres:17.11-alpine
ContainerName=arcane-postgres
Network=arcane.network
Volume={{ arcane_data_dir }}/postgres:/var/lib/postgresql/data:z
Environment=POSTGRES_DB={{ arcane_postgres_db }}
Environment=POSTGRES_USER={{ arcane_postgres_user }}
# POSTGRES_PASSWORD. Quadlet copies Environment= values into the world-readable
# generated service, so the secret goes in a 0600 root env file.
EnvironmentFile={{ arcane_data_dir }}/arcane-postgres.env

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
